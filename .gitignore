# Keep sample source files and non-sensitive sample JSON.
!applications/**/*.md
!applications/**/artifacts/*.json
!master-resumes/*.yaml

# Claude Code hook escape hatch, created only for an authorized vendor snapshot update.
.claude/ALLOW_VENDOR_SNAPSHOT_UPDATE
